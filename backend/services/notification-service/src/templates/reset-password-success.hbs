<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed Successfully</title>
</head>

<body
    style="margin:0;padding:0;background-color:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#333333;">

    <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;background:#f4f4f4;">
        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0"
                    style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.08);">

                    <!-- Header -->
                    <tr>
                        <td align="center"
                            style="background:#16a34a;padding:30px;color:white;font-size:28px;font-weight:bold;">
                            ✅ Password Changed
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:40px;">

                            <h2 style="margin-top:0;color:#111827;">
                                Hello {{fullName}},
                            </h2>

                            <p style="font-size:16px;line-height:28px;">
                                Your <strong>RescrapX</strong> account password has been changed successfully.
                            </p>

                            <div
                                style="background:#ecfdf5;border-left:5px solid #16a34a;padding:20px;margin:30px 0;border-radius:8px;">

                                <h3 style="margin-top:0;color:#166534;">
                                    ✔ Password Updated Successfully
                                </h3>

                                <p style="margin-bottom:0;font-size:15px;">
                                    Your account is now protected with your new password.
                                </p>

                            </div>

                            <h3 style="color:#111827;">
                                Didn't change your password?
                            </h3>

                            <p style="font-size:15px;line-height:26px;color:#555;">
                                If you did <strong>NOT</strong> make this change,
                                your account may have been compromised.
                                Please contact our support team immediately and secure your account.
                            </p>

                            <p style="margin-top:35px;">
                                Thank you for choosing
                                <strong>RescrapX.</strong>
                            </p>

                            <p>
                                Regards,<br>
                                <strong>RescrapX Team</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center"
                            style="padding:20px;background:#f9fafb;color:#6b7280;font-size:13px;">

                            © {{year}} RescrapX. All rights reserved.

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>